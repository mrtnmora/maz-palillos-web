---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="MAZ Palillos de Madera" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && site.media.posterEnabled && (
      <meta property="og:image" content={new URL(site.media.poster, Astro.site)} />
    )}
    <meta name="theme-color" content="#b40e0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body id="inicio">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
