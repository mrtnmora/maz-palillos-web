---
import { site } from '../data/site';
const { contact } = site;
const channels = [
  { label: 'WhatsApp', value: contact.whatsapp, href: contact.whatsapp ? `https://wa.me/${contact.whatsapp}` : undefined },
  { label: 'Correo de ventas', value: contact.email, href: contact.email ? `mailto:${contact.email}` : undefined },
  { label: 'Teléfono', value: contact.phone, href: contact.phone ? `tel:${contact.phone}` : undefined },
  { label: 'Ubicación', value: contact.location, href: undefined },
];
---
<section id="contacto" class="section container contact" aria-labelledby="contact-title">
  <div>
    <p class="eyebrow">04 / CONTACTO</p>
    <h2 id="contact-title">El comienzo de<br />un buen pedido.</h2>
    <p>Para orientarte, comparte el formato, las medidas, la aplicación y el volumen que necesitas.</p>
  </div>
  <div>
    <dl class="contact-channels">
      {channels.map(channel => (
        <div>
          <dt>{channel.label}</dt>
          <dd>
            {channel.href ? (
              channel.label === 'WhatsApp' ? (
                <a
                  class="whatsapp-link"
                  href={channel.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Abrir chat de WhatsApp"
                  aria-label={`Abrir chat de WhatsApp con MAZ al +${contact.whatsapp} (se abre en otra pestaña)`}
                >
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.47 0 .11 5.35.1 11.94c0 2.1.55 4.16 1.6 5.98L0 24l6.24-1.64a11.95 11.95 0 0 0 5.8 1.48h.01c6.58 0 11.94-5.35 11.95-11.94a11.87 11.87 0 0 0-3.48-8.42ZM12.05 21.82a9.91 9.91 0 0 1-5.05-1.38l-.36-.21-3.7.97.99-3.61-.24-.37a9.9 9.9 0 0 1-1.52-5.28c0-5.48 4.46-9.94 9.95-9.94a9.88 9.88 0 0 1 7.03 2.92 9.88 9.88 0 0 1 2.91 7.04c0 5.48-4.46 9.94-9.94 9.94Zm5.45-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.11.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
                  </svg>
                </a>
              ) : <a href={channel.href}>{channel.value} ↗</a>
            ) : channel.value || <span class="pending">Por confirmar</span>}
          </dd>
        </div>
      ))}
    </dl>
    {channels.some(channel => !channel.value) && (
      <p class="contact-note">Los demás canales de atención se habilitarán al confirmar los datos de MAZ.</p>
    )}
  </div>
</section>
