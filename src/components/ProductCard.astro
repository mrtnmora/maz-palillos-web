---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';

interface Props { product: Product; index: number }
const { product, index } = Astro.props;
---

<article class="product-card">
  <div class="product-image">
    <Image
      src={product.images[0]}
      alt={product.name + ', fotografía de producto MAZ'}
      widths={[360, 600, 900]}
      sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 30vw"
      width={600}
      format="webp"
      loading="lazy"
    />
  </div>
  <div class="product-label">
    <span>FORMATO {String(index + 1).padStart(2, '0')}</span>
    <span>{product.application}</span>
  </div>
  <h3>{product.name}</h3>
  <p>{product.description}</p>
  <p class="dimensions">{product.dimensions}</p>
  {product.packaging && <p>Presentación: {product.packaging}</p>}
  {product.technicalDetails && <p>{product.technicalDetails}</p>}
  {product.images.length > 1 && (
    <details>
      <summary>Más fotografías <span aria-hidden="true">+</span></summary>
      <div class="product-gallery">
        {product.images.slice(1).map((src, i) => (
          <Image
            src={src}
            alt={`${product.name}, vista adicional ${i + 1}`}
            width={480}
            format="webp"
            loading="lazy"
          />
        ))}
      </div>
    </details>
  )}
  <a href="#contacto" class="text-link" aria-label={`Consultar formato: ${product.name}`}>
    Consultar formato <span aria-hidden="true">↗</span>
  </a>
</article>
